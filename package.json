{
  "name": "task-matrix",
  "productName": "任务矩阵",
  "version": "1.0.0",
  "description": "常驻任务栏的四象限计划工具，电子工业风",
  "author": "Cherry",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node build/make-icon.js",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.taskmatrix.app",
    "productName": "任务矩阵",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "taskbar.js",
      "taskbar-space.js",
      "renderer/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ],
      "artifactName": "TaskMatrix-${version}-免安装版.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "任务矩阵",
      "uninstallDisplayName": "任务矩阵",
      "installerLanguages": ["zh_CN"],
      "language": "2052",
      "runAfterFinish": true,
      "artifactName": "TaskMatrix-Setup-${version}.${ext}"
    }  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "koffi": "^3.3.3"
  }
}
